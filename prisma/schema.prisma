generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model job_app {
  job_app_id         Int          @id @default(autoincrement())
  job_app_userid     Int?
  job_app_title      String       @db.VarChar(255)
  job_app_company    String       @db.VarChar(255)
  job_app_applied    DateTime     @db.Date
  job_app_updated    DateTime?    @db.Date
  job_app_status     String       @db.VarChar(255)
  job_app_applied_at String       @db.VarChar(255)
  job_app_notes      String?
  userdata           userdata?    @relation(fields: [job_app_userid], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  job_status         job_status[]
}

model job_status {
  job_status_id Int      @id @default(autoincrement())
  job_id        Int
  status        String   @db.VarChar(255)
  updated_at    DateTime @default(now()) @db.Timestamp(6)
  job_app       job_app  @relation(fields: [job_id], references: [job_app_id], onDelete: Cascade, onUpdate: NoAction)
}

model token {
  token_id      Int       @id @default(autoincrement())
  user_id       Int?      @unique
  access_token  String?
  refresh_token String?
  expires_at    DateTime  @db.Date
  userdata      userdata? @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_processes {
  user_process_id       Int      @id @default(autoincrement())
  user_process_complete Boolean
  user_id               Int
  userdata              userdata @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
}

model userdata {
  user_id        Int              @id @default(autoincrement())
  first_name     String           @db.VarChar(50)
  last_name      String           @db.VarChar(50)
  email          String
  join_date      DateTime         @default(dbgenerated("CURRENT_DATE")) @db.Date
  job_app        job_app[]
  token          token?
  user_processes user_processes[]
}
